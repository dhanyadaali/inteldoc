# ---- Database -------------------------------------------------------------
# Local (docker compose up -d):
DATABASE_URL=postgresql://inteldoc:inteldoc@localhost:5433/inteldoc
# Free hosted: create a project at https://neon.tech and paste its connection string, e.g.
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ---- LLM (any OpenAI-compatible endpoint) ----------------------------------
# Default: Groq free tier running OpenAI's open-weight gpt-oss-120b. Key: https://console.groq.com/keys
GROQ_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b
# LLM_VISION=false

# OpenAI directly (paid):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# LLM_VISION=true

# ---- Policy knobs (defaults shown) -----------------------------------------
# AMOUNT_TOLERANCE=0.02
# PO_OVERRUN_TOLERANCE=0.02
# DUPLICATE_WINDOW_DAYS=30
# STALE_INVOICE_DAYS=365
# DATE_ORDER=MDY

